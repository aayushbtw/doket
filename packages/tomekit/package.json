{
  "name": "tomekit",
  "version": "0.5.0",
  "description": "Fully typed content collections for Markdown.",
  "keywords": [
    "collections",
    "content",
    "frontmatter",
    "markdown",
    "standard-schema",
    "vite",
    "vite-plugin"
  ],
  "homepage": "https://github.com/aayushbtw/tomekit#readme",
  "bugs": "https://github.com/aayushbtw/tomekit/issues",
  "license": "MIT",
  "author": "Aayush",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aayushbtw/tomekit.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./content": {
      "types": "./dist/content.d.mts",
      "default": "./dist/content.mjs"
    },
    "./vite": {
      "types": "./dist/vite.d.mts",
      "default": "./dist/vite.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "prepublishOnly": "vp check && vp test run && vp pack",
    "test": "vp test run"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "zod": "^4.6.2"
  },
  "peerDependencies": {
    "vite": ">=8.0.0"
  },
  "engines": {
    "node": ">=24"
  }
}
