{
  "name": "doket",
  "version": "0.0.0",
  "description": "Typed content collections for Vite. Parsed at build, nothing at runtime.",
  "keywords": [
    "collections",
    "content",
    "frontmatter",
    "markdown",
    "standard-schema",
    "vite",
    "vite-plugin"
  ],
  "homepage": "https://github.com/aayushbtw/doket#readme",
  "bugs": "https://github.com/aayushbtw/doket/issues",
  "author": "Aayush",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aayushbtw/doket.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./vite": {
      "types": "./dist/vite.d.mts",
      "default": "./dist/vite.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "ultracite": "^7.11.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.0",
    "zod": "^4.6.2"
  },
  "peerDependencies": {
    "vite": ">=6.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
