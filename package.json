{
  "name": "tomekit",
  "version": "0.2.0",
  "description": "Typed content collections for Vite. Parsed at build, nothing at runtime.",
  "keywords": [
    "collections",
    "content",
    "frontmatter",
    "markdown",
    "standard-schema",
    "vite",
    "vite-plugin"
  ],
  "homepage": "https://github.com/aayushbtw/tomekit#readme",
  "bugs": "https://github.com/aayushbtw/tomekit/issues",
  "license": "MIT",
  "author": "Aayush",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aayushbtw/tomekit.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./content": {
      "types": "./dist/content.d.mts",
      "default": "./dist/content.mjs"
    },
    "./query": {
      "types": "./dist/query.d.mts",
      "default": "./dist/query.mjs"
    },
    "./vite": {
      "types": "./dist/vite.d.mts",
      "default": "./dist/vite.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "fix": "vp check --fix",
    "prepublishOnly": "vp check && vp test run && vp pack",
    "test": "vp test run"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "typescript": "^7.0.2",
    "ultracite": "7.11.0",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "zod": "^4.6.2"
  },
  "peerDependencies": {
    "vite": ">=6.4.0"
  },
  "engines": {
    "node": ">=22.17.0"
  },
  "packageManager": "pnpm@12.4.1"
}
